{
  "name": "koreader-ecosystem-desktop",
  "productName": "KOReader Ecosystem",
  "version": "0.3.7",
  "description": "Biblioteca local, Calibre e sincronização KOReader",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bellussi1/koreader-ecosystem.git"
  },
  "private": true,
  "type": "module",
  "main": ".vite/build/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron-forge start",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "package:sidecar": "pwsh -NoProfile -File scripts/package-sidecar.ps1",
    "prepackage": "npm run package:sidecar",
    "premake": "npm run package:sidecar",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "prepare": "cd .. && node desktop/node_modules/husky/bin.js"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.22",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
