      "old": "local Api = require(\"hardcover/lib/hardcover_api\")\nlocal User = require(\"hardcover/lib/user\")\n\nlocal Cache = {}\nCache.__index = Cache\n\nfunction Cache:new(o)\n  return setmetatable(o, self)\nend\n\nfunction Cache:updateBookStatus(filename, status, privacy_setting_id)\n  local settings = self.settings:readBookSettings(filename)\n  local book_id = settings.book_id\n  local edition_id = settings.edition_id\n\n  self.state.book_status = Api:updateUserBook(book_id, status, privacy_setting_id, edition_id) or {}\nend\n\nfunction Cache:cacheUserBook()\n  local status, errors = Api:findUserBook(self.settings:getLinkedBookId(), User:getId())\n  self.state.book_status = status or {}\n\n  return errors\nend\n\nreturn Cache\n",
      "new": "local Api = require(\"hardcover/lib/hardcover_api\")\nlocal User = require(\"hardcover/lib/user\")\nlocal HARDCOVER = require(\"hardcover/lib/constants/hardcover\")\n\nlocal Cache = {}\nCache.__index = Cache\n\nfunction Cache:new(o)\n  return setmetatable(o, self)\nend\n\nfunction Cache:updateBookStatus(filename, status, privacy_setting_id)\n  local settings = self.settings:readBookSettings(filename) or {}\n  local book_id = settings.book_id\n  local edition_id = settings.edition_id\n  local finished_read = false\n\n  if status == HARDCOVER.STATUS.FINISHED then\n    local errors = self:cacheUserBook()\n    if errors then\n      return nil\n    end\n    local reads = self.state.book_status.user_book_reads or {}\n    local current_read = reads[#reads]\n    if current_read and not current_read.finished_at then\n      local result = Api:finishRead(current_read.id, os.date(\"%Y-%m-%d\"))\n      if not result then\n        return nil\n      end\n      self.state.book_status = result\n      finished_read = true\n    end\n  end\n\n  local updated = Api:updateUserBook(book_id, status, privacy_setting_id, edition_id)\n  if updated then\n    self.state.book_status = updated\n    if status == HARDCOVER.STATUS.FINISHED and finished_read then\n      self.settings:updateBookSetting(filename, { _delete = { \"hardcover_started_at\" } })\n    end\n  end\n  return self.state.book_status\nend\n\nfunction Cache:ensureReadingRecord(filename, page)\n  local settings = self.settings:readBookSettings(filename) or {}\n  local user_book = self.state.book_status or {}\n\n  if not user_book.id or user_book.status_id ~= HARDCOVER.STATUS.READING then\n    self:updateBookStatus(filename, HARDCOVER.STATUS.READING, user_book.privacy_setting_id)\n    user_book = self.state.book_status or {}\n  end\n  if not user_book.id then\n    return nil\n  end\n\n  local reads = user_book.user_book_reads or {}\n  local current_read = reads[#reads]\n  if current_read and not current_read.finished_at then\n    if current_read.started_at then\n      self.settings:updateBookSetting(filename, { hardcover_started_at = current_read.started_at })\n    end\n    return current_read\n  end\n\n  local edition_id = settings.edition_id or (current_read and current_read.edition_id) or user_book.edition_id\n  if not edition_id then\n    return nil\n  end\n\n  local started_at = self.settings:readBookSetting(filename, \"hardcover_started_at\")\n  if type(started_at) ~= \"string\" or not string.match(started_at, \"^%d%d%d%d%-%d%d%-%d%d$\") then\n    started_at = os.date(\"%Y-%m-%d\")\n    self.settings:updateBookSetting(filename, { hardcover_started_at = started_at })\n  end\n\n  local updated = Api:createRead(user_book.id, edition_id, page, started_at)\n  if not updated then\n    return nil\n  end\n  self.state.book_status = updated\n  local created_reads = updated.user_book_reads or {}\n  return created_reads[#created_reads]\nend\n\nfunction Cache:cacheUserBook()\n  local status, errors = Api:findUserBook(self.settings:getLinkedBookId(), User:getId())\n  self.state.book_status = status or {}\n\n  return errors\nend\n\nreturn Cache\n"
