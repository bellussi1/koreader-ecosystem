    {
      "path": "main.lua",
      "old": "function HardcoverApp:startReadCache()\n  --logger.warn(\"HARDCOVER start read cache\")\n  if self.state.read_cache_started then\n    --logger.warn(\"HARDCOVER Cache already started\")\n    return\n  end\n\n  if not self.ui.document then\n    --logger.warn(\"HARDCOVER read cache fired outside of document\")\n    return\n  end\n\n  self.state.read_cache_started = true\n\n  local cancel\n\n  local restart = function(delay)\n    --logger.warn(\"HARDCOVER restart cache fetch\")\n    delay = delay or 60\n    cancel()\n    self.state.read_cache_started = false\n    UIManager:scheduleIn(delay, self.startReadCache, self)\n  end\n\n  cancel = Scheduler:withRetries(6, 3, function(success, fail)\n      Trapper:wrap(function()\n        if not self.ui.document then\n          -- fail, but cancel retries\n          return success()\n        end\n        local book_settings = self.settings:readBookSettings(self.ui.document.file) or {}\n        --logger.warn(\"HARDCOVER\", book_settings)\n        if book_settings.book_id then\n          if self.state.book_status.id then\n            return success()\n          else\n            self.wifi:withWifi(function()\n              if not NetworkManager:isConnected() then\n                return restart()\n              end\n\n              local err = self.cache:cacheUserBook()\n              --if err then\n              --logger.warn(\"HARDCOVER cache error\", err)\n              --end\n              if err and err.completed == false then\n                return fail(err)\n              end\n\n              success()\n            end)\n          end\n        else\n          self.hardcover:tryAutolink()\n          if self.settings:bookLinked() and self.settings:syncEnabled() then\n            return restart(2)\n          end\n        end\n      end)\n    end,\n\n    function()\n      if self.settings:syncEnabled() then\n        --logger.warn(\"HARDCOVER enabling page turns\")\n\n        self.state.process_page_turns = true\n      end\n    end,\n\n    function()\n      if NetworkManager:isConnected() then\n        UIManager:show(Notification:new {\n          text = _(\"Failed to fetch book information from Hardcover\"),\n        })\n      end\n    end)\nend\n",
      "new": "function HardcoverApp:_scheduleProgressRetry(filename)\n  if self.state.progress_retry_pending or not self.settings:syncEnabled() then\n    return\n  end\n  self.state.progress_retry_pending = true\n  UIManager:scheduleIn(60, function()\n    self.state.progress_retry_pending = false\n    if not self.ui.document or self.ui.document.file ~= filename or not self.settings:syncEnabled() then\n      return\n    end\n    self.state.read_cache_started = false\n    self.state.book_status = {}\n    self:startReadCache()\n  end)\nend\n\nfunction HardcoverApp:syncLatestPage(filename)\n  if not self.ui.document or not self:syncFileUpdates(filename) then\n    return\n  end\n\n  local current_page = self.ui:getCurrentPage()\n  self.state.page = current_page\n  local mapped_page = self.page_mapper:getMappedPage(\n    current_page,\n    self.ui.document:getPageCount(),\n    self.settings:pages()\n  )\n  local reads = self.state.book_status.user_book_reads or {}\n  local current_read = reads[#reads]\n  if not current_read or current_read.finished_at then\n    current_read = self.cache:ensureReadingRecord(filename, mapped_page)\n  end\n  if not current_read then\n    self.settings:updateBookSetting(filename, { hardcover_sync_pending = true })\n    self:_scheduleProgressRetry(filename)\n    return\n  end\n\n  local remote_page = current_read.progress_pages or 0\n  local last_synced_page = self.settings:readBookSetting(filename, \"hardcover_last_synced_page\")\n  local function askForProgressChoice()\n    self.settings:updateBookSetting(filename, { hardcover_sync_pending = \"conflict\" })\n    self.dialog_manager:confirm {\n      text = string.format(\n        _(\"Progress changed in both places while offline. Kindle: %d, Hardcover: %d.\"),\n        mapped_page,\n        remote_page\n      ),\n      ok_text = _(\"Use Kindle\"),\n      cancel_text = _(\"Keep Hardcover\"),\n      ok_callback = function()\n        self:_handlePageUpdate(filename, mapped_page, true)\n      end,\n      cancel_callback = function()\n        self:_recordProgressSync(filename, remote_page)\n      end,\n    }\n  end\n\n  if type(last_synced_page) == \"number\" and remote_page ~= last_synced_page then\n    if mapped_page == last_synced_page then\n      self:_recordProgressSync(filename, remote_page)\n      return\n    elseif mapped_page ~= remote_page then\n      askForProgressChoice()\n      return\n    end\n  elseif last_synced_page == nil and remote_page > 0 and mapped_page ~= remote_page then\n    askForProgressChoice()\n    return\n  end\n\n  if mapped_page ~= remote_page then\n    self:_handlePageUpdate(filename, mapped_page, true)\n  else\n    self:_recordProgressSync(filename, remote_page)\n  end\nend\n\nfunction HardcoverApp:startReadCache()\n  if self.state.read_cache_started then\n    return\n  end\n\n  if not self.ui.document then\n    return\n  end\n\n  self.state.read_cache_started = true\n\n  local cancel\n  local restart = function(delay)\n    delay = delay or 60\n    cancel()\n    self.state.read_cache_started = false\n    UIManager:scheduleIn(delay, self.startReadCache, self)\n  end\n\n  local filename = self.ui.document.file\n  local book_settings = self.settings:readBookSettings(filename) or {}\n  if book_settings.book_id and self.settings:syncEnabled()\n    and not self.settings:readBookSetting(filename, \"hardcover_started_at\") then\n    self.settings:updateBookSetting(filename, { hardcover_started_at = os.date(\"%Y-%m-%d\") })\n  end\n\n  cancel = Scheduler:withRetries(6, 3, function(success, fail)\n    Trapper:wrap(function()\n      if not self.ui.document then\n        return success()\n      end\n      local current_settings = self.settings:readBookSettings(self.ui.document.file) or {}\n      if current_settings.book_id then\n        self.wifi:withWifi(function()\n          if not NetworkManager:isConnected() then\n            self.settings:updateBookSetting(filename, { hardcover_sync_pending = true })\n            return restart()\n          end\n\n          local err = self.cache:cacheUserBook()\n          if err and err.completed == false then\n            return fail(err)\n          end\n\n          if not err and self.settings:syncEnabled() then\n            local current_page = self.ui:getCurrentPage()\n            self.state.page = current_page\n            local mapped_page = self.page_mapper:getMappedPage(\n              current_page,\n              self.ui.document:getPageCount(),\n              self.settings:pages()\n            )\n            local read = self.cache:ensureReadingRecord(self.ui.document.file, mapped_page)\n            if read then\n              self:syncLatestPage(self.ui.document.file)\n            else\n              self.settings:updateBookSetting(filename, { hardcover_sync_pending = true })\n              self:_scheduleProgressRetry(filename)\n            end\n          end\n\n          success()\n        end)\n      else\n        self.hardcover:tryAutolink()\n        if self.settings:bookLinked() and self.settings:syncEnabled() then\n          return restart(2)\n        end\n      end\n    end)\n  end,\n    function()\n      if self.settings:syncEnabled() then\n        self.state.process_page_turns = true\n      end\n    end,\n    function()\n      self.state.read_cache_started = false\n      self.settings:updateBookSetting(filename, { hardcover_sync_pending = true })\n      self:_scheduleProgressRetry(filename)\n      if NetworkManager:isConnected() then\n        UIManager:show(Notification:new {\n          text = _(\"Failed to fetch book information from Hardcover; progress will retry\"),\n        })\n      end\n    end)\nend\n"
    },
    {
      "path": "main.lua",
      "old": "function HardcoverApp:addToMainMenu(menu_items)\n  menu_items.hardcover = self.menu:mainMenu()\nend",
      "new": "function HardcoverApp:addToMainMenu(menu_items)\n  menu_items.hardcover = self.menu:mainMenu()\n  local main_menu = menu_items.hardcover\n  local original_submenu = main_menu.sub_item_table_func\n  main_menu.sub_item_table_func = function()\n    local items = original_submenu()\n    table.insert(items, 1, {\n      text_func = function()\n        return string.format(_(\"Hardcover API requests: %d / %d (last 24 hours)\"),\n          self:_hardcoverRequestUsage(), HARDCOVER_APP_DAILY_LIMIT)\n      end,\n      enabled_func = function() return false end,\n      keep_menu_open = true,\n      separator = true,\n    })\n    table.insert(items, 1, {\n      text_func = function()\n        local filename = self.ui.document and self.ui.document.file\n        if not filename or not self.settings:bookLinked() then\n          return _(\"Link a book to see sync status\")\n        end\n        local pending = self.settings:readBookSetting(filename, \"hardcover_sync_pending\")\n        if pending == \"conflict\" then\n          return _(\"Progress conflict: choose Kindle or Hardcover\")\n        end\n        if pending then\n          return _(\"Progress sync pending · will retry over Wi-Fi\")\n        end\n        local last_sync = self.settings:readBookSetting(filename, \"hardcover_last_synced_at\")\n        if last_sync then\n          return _(\"Last Hardcover sync: \" .. last_sync)\n        end\n        return _(\"Progress has not been confirmed by Hardcover yet\")\n      end,\n      enabled_func = function()\n        return self.settings:bookLinked()\n      end,\n      keep_menu_open = true,\n      separator = true,\n    })\n    return items\n  end\nend"
    },
    {
      "path": "main.lua",
      "old": "function HardcoverApp:init()",
      "new": "local HARDCOVER_APP_DAILY_LIMIT = 2000\nlocal HARDCOVER_APP_PER_MINUTE_LIMIT = 25\nlocal HARDCOVER_REQUEST_WINDOW_SECONDS = 24 * 60 * 60\nlocal HARDCOVER_REQUEST_TIMESTAMPS_KEY = \"koreader_ecosystem_hardcover_request_times_v1\"\n\nfunction HardcoverApp:_readHardcoverRequestWindow()\n  local stored = self.settings:readSetting(HARDCOVER_REQUEST_TIMESTAMPS_KEY)\n  if stored == nil then\n    return {}, 0, 0, true\n  end\n  if type(stored) ~= \"table\" then\n    return nil, HARDCOVER_APP_DAILY_LIMIT, HARDCOVER_APP_PER_MINUTE_LIMIT, false\n  end\n\n  local now = os.time()\n  local recent = {}\n  local minute_count = 0\n  for key, timestamp in pairs(stored) do\n    if type(key) ~= \"number\" or type(timestamp) ~= \"number\" then\n      return nil, HARDCOVER_APP_DAILY_LIMIT, HARDCOVER_APP_PER_MINUTE_LIMIT, false\n    end\n    if timestamp > now - HARDCOVER_REQUEST_WINDOW_SECONDS then\n      table.insert(recent, timestamp)\n      if timestamp > now - 60 then\n        minute_count = minute_count + 1\n      end\n    end\n  end\n  return recent, #recent, minute_count, true\nend\n\nfunction HardcoverApp:_hardcoverRequestUsage()\n  local _, count, _, valid = self:_readHardcoverRequestWindow()\n  if not valid then\n    return HARDCOVER_APP_DAILY_LIMIT\n  end\n  return count\nend\n\nfunction HardcoverApp:_reserveHardcoverRequest()\n  local recent, count, minute_count, valid = self:_readHardcoverRequestWindow()\n  if not valid or count >= HARDCOVER_APP_DAILY_LIMIT or minute_count >= HARDCOVER_APP_PER_MINUTE_LIMIT then\n    return false\n  end\n  table.insert(recent, os.time())\n  local saved = pcall(function()\n    self.settings:updateSetting(HARDCOVER_REQUEST_TIMESTAMPS_KEY, recent)\n  end)\n  return saved\nend\n\nfunction HardcoverApp:_installHardcoverRequestGuard()\n  Api.koreader_ecosystem_budget_reserver = function()\n    return self:_reserveHardcoverRequest()\n  end\n  Api.koreader_ecosystem_budget_notifier = function()\n    if self.state.hardcover_budget_notified then\n      return\n    end\n    self.state.hardcover_budget_notified = true\n    UIManager:show(Notification:new {\n      text = _(\"Hardcover sync paused: local request limit reached\"),\n    })\n  end\n\n  if Api.koreader_ecosystem_budget_guard_installed then\n    return\n  end\n  local original_query = Api.query\n  Api.query = function(api, ...)\n    if NetworkManager:isConnected() and api.enabled then\n      local reserve = Api.koreader_ecosystem_budget_reserver\n      if type(reserve) ~= \"function\" or not reserve() then\n        local notify = Api.koreader_ecosystem_budget_notifier\n        if type(notify) == \"function\" then\n          notify()\n        end\n        return nil, { completed = false, errors = { { message = \"Local request budget reached\" } } }\n      end\n    end\n    return original_query(api, ...)\n  end\n  Api.koreader_ecosystem_budget_guard_installed = true\nend\n\nfunction HardcoverApp:init()"
    },
